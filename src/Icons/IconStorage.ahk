LoadIconSettings() {
    global ICON_CONFIG, SETTINGS_FILE, ICON_PRESET_IDS
    mode := IniRead(SETTINGS_FILE, "Icon", "Mode", "preset")
    preset := IniRead(SETTINGS_FILE, "Icon", "Preset", "cursor")
    custom := IniRead(SETTINGS_FILE, "Icon", "CustomPath", "")
    if mode != "default" && mode != "preset" && mode != "custom"
        mode := "preset"
    if !ListIndex(ICON_PRESET_IDS, preset)
        preset := "cursor"
    ; Do not silently install a replacement icon when the custom file was removed.
    if mode = "custom" && !FileExist(custom)
        mode := "default"
    ICON_CONFIG := {mode:mode, preset:preset, customPath:custom}
}

SaveIconSettings() {
    global ICON_CONFIG, SETTINGS_DIR, SETTINGS_FILE
    DirCreate(SETTINGS_DIR)
    IniWrite(ICON_CONFIG.mode, SETTINGS_FILE, "Icon", "Mode")
    IniWrite(ICON_CONFIG.preset, SETTINGS_FILE, "Icon", "Preset")
    IniWrite(ICON_CONFIG.customPath, SETTINGS_FILE, "Icon", "CustomPath")
}

IconFilePath(config) {
    if config.mode = "default"
        return ""
    if config.mode = "custom"
        return config.customPath
    return EnsurePresetIcon(config.preset)
}

EnsurePresetIcon(preset) {
    global SETTINGS_DIR, ICON_PRESET_IDS
    if !ListIndex(ICON_PRESET_IDS, preset)
        throw Error("不明なアイコンの種類です: " preset)
    folder := SETTINGS_DIR "\icons"
    dest := folder "\preset_" preset ".ico"
    if FileExist(dest) && IsLoadableIcon(dest)
        return dest
    DirCreate(folder)
    encoded := PresetIconBase64(preset)
    if encoded = ""
        throw Error("プリセットアイコンのデータを取得できません: " preset)
    needed := 0
    flags := 1 ; CRYPT_STRING_BASE64
    ok := DllCall("crypt32\CryptStringToBinaryW", "WStr", encoded, "UInt", 0,
        "UInt", flags, "Ptr", 0, "UInt*", &needed, "Ptr", 0, "Ptr", 0, "Int")
    if !ok || needed < 100
        throw Error("アイコンのデコードサイズを取得できません。")
    data := Buffer(needed)
    ok := DllCall("crypt32\CryptStringToBinaryW", "WStr", encoded, "UInt", 0,
        "UInt", flags, "Ptr", data.Ptr, "UInt*", &needed, "Ptr", 0, "Ptr", 0, "Int")
    if !ok
        throw Error("プリセットアイコンをデコードできません。")
    fh := FileOpen(dest, "w")
    if !IsObject(fh)
        throw Error("アイコンを書き込めません: " dest)
    try fh.RawWrite(data, needed)
    finally fh.Close()
    if !IsLoadableIcon(dest)
        throw Error("生成したプリセットアイコンをWindowsが読み込めませんでした。")
    return dest
}

IsLoadableIcon(path) {
    if !FileExist(path) || !RegExMatch(path, "i)\.ico$")
        return false
    hIcon := DllCall("user32\LoadImageW", "Ptr", 0, "WStr", path,
        "UInt", 1, "Int", 32, "Int", 32, "UInt", 0x10, "Ptr")
    if !hIcon
        return false
    DllCall("user32\DestroyIcon", "Ptr", hIcon)
    return true
}

; The icon data is included in this script, so no additional downloads are needed.
; Note: these preset .ico files are generated by our own script assets.
